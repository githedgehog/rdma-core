{
        /* FIXME: It is probably not a great idea to not tag these with the
	   proper symbol version from glibc, at least if glibc ever changes
	   the signature this will go sideways.. */
	global:
		accept;
		accept4;
		bind;
		close;
		connect;
		dup;
		dup2;
		fcntl;
@RDMA_PRELOAD_MAP_FCNTL64@
		getpeername;
		getsockname;
		getsockopt;
		listen;
		poll;
		read;
		readv;
		recv;
		recvmsg;
		select;
		send;
		sendfile;
@RDMA_PRELOAD_MAP_SENDFILE64@
		sendmsg;
		sendto;
		setsockopt;
		shutdown;
		socket;
		write;
		writev;
	local: *;
};
